{
    "name": "ttpryg/cart-engine",
    "description": "A framework-agnostic standalone item-agnostic cart engine library for shopping and booking systems.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Ttpryg\\CartEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\CartEngine\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
